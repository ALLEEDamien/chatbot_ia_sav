# =============================================================================
# Variables d'environnement du BACKEND (FastAPI)
# =============================================================================
# Utilisation : copiez ce fichier en ".env" (dans le dossier backend) puis
# remplacez les valeurs. Le fichier ".env" est ignoré par git : ne le
# commitez JAMAIS, il contient des secrets.
#
#   cp .env.example .env        (Windows PowerShell : Copy-Item .env.example .env)
#
# Le serveur doit être redémarré après toute modification.
# Légende : [OBLIGATOIRE] = le chatbot ne répond pas sans elle
#           [OPTIONNEL]   = une valeur par défaut existe
# =============================================================================


# -----------------------------------------------------------------------------
# GROQ_API_KEY  [OBLIGATOIRE]
# Clé d'API Groq, utilisée pour interroger le modèle de langage.
# Créez-en une sur https://console.groq.com/keys (commence par "gsk_").
# Sans elle, le chat répond "Une erreur est survenue...".
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here


# -----------------------------------------------------------------------------
# GROQ_MODEL  [OPTIONNEL]
# Identifiant du modèle Groq utilisé pour répondre.
# Défaut : llama-3.3-70b-versatile
# Si Groq retire ce modèle, changez uniquement cette ligne, aucun code à modifier
# (voir https://console.groq.com/docs/deprecations).
# -----------------------------------------------------------------------------
GROQ_MODEL=llama-3.3-70b-versatile


# -----------------------------------------------------------------------------
# COMPANY_NAME  [OPTIONNEL]
# Nom de l'entreprise, affiché dans l'en-tête du widget de chat
# ("Assistant <COMPANY_NAME>").
# Défaut : notre entreprise
# -----------------------------------------------------------------------------
COMPANY_NAME=Votre Entreprise


# -----------------------------------------------------------------------------
# CORS_ORIGINS  [OPTIONNEL]
# Adresses du frontend autorisées à appeler l'API, séparées par des virgules,
# sans espace ni "/" final. À adapter en production.
# Défaut : http://localhost:5173 (serveur de développement Vite)
# Exemple : https://www.mon-site.fr,https://admin.mon-site.fr
# -----------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173


# -----------------------------------------------------------------------------
# CHROMA_PATH  [OPTIONNEL]
# Dossier de la base vectorielle ChromaDB (documents et catalogue indexés).
# Chemin relatif au dossier depuis lequel uvicorn est lancé.
# Défaut : ./chroma_db
# -----------------------------------------------------------------------------
# CHROMA_PATH=./chroma_db


# -----------------------------------------------------------------------------
# EMBEDDING_MODEL  [OPTIONNEL]
# Modèle sentence-transformers qui transforme les textes en vecteurs.
# Défaut : all-MiniLM-L6-v2 (léger, anglais/multilingue correct).
# ATTENTION : si vous le changez, supprimez le dossier CHROMA_PATH et
# réindexez vos documents. Les anciens vecteurs ne sont plus compatibles.
# -----------------------------------------------------------------------------
# EMBEDDING_MODEL=all-MiniLM-L6-v2
